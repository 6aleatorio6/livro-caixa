{
  "expo": {
    "name": "Livro-Caixa",
    "slug": "livro-caixa",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "livrocaixa",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#C6ECCB",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.leonardolf.livrocaixa",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "image/*",
              "application/pdf"
            ],
            "multipleShareMimeTypes": []
          }
        }
      ],
      [
        "@react-native-community/datetimepicker",
        {
          "android": {
            "datePicker": {
              "colorAccent": {
                "light": "#45664C",
                "dark": "#ABD0B0"
              },
              "windowBackground": {
                "light": "#E6E9E3",
                "dark": "#272B27"
              },
              "textColorPrimary": {
                "light": "#191D19",
                "dark": "#E0E3DD"
              },
              "textColorSecondary": {
                "light": "#3F4940",
                "dark": "#BECABD"
              }
            }
          }
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Figtree",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Figtree_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Figtree_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Figtree_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Figtree_700Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7FAF4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 192,
          "dark": {
            "backgroundColor": "#101411",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.4.0",
            "packagingOptions": {
              "pickFirst": [
                "**/libc++_shared.so"
              ]
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
