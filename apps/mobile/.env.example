# Copie para `.env` (fora do Git) e preencha. O Expo lê o arquivo no build e no Metro, e o `pnpm apk` lê a senha da chave.

# O client id do tipo Web do login pelo Google: no console do Firebase, Authentication > Google, ou o
# `oauth_client` com `client_type: 3` do `google-services.json`. Sem ele, "Entrar com Google" falha.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Os emuladores do Firebase. O `pnpm journeys:stack` liga a primeira, e o `pnpm apk` a desliga: deixe as
# duas de fora para o app falar com o Firebase de verdade.
# EXPO_PUBLIC_USE_FIREBASE_EMULATOR=true
# O endereço dos emuladores visto pelo celular; o padrão, 10.0.2.2, é o PC visto do emulador do Android.
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=10.0.2.2

# A senha da chave que assina o APK de release, em `release/livro-caixa.keystore` (fora do Git, com cópia de
# segurança: sem a chave e a senha, o app instalado não recebe mais atualizações). Só o `pnpm apk` a lê; sem o
# `EXPO_PUBLIC_`, ela não entra no app.
RELEASE_KEYSTORE_PASSWORD=
