{
  "name": "livro-caixa",
  "version": "0.2.1",
  "description": "App de celular para controlar o financeiro de uma família",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "docusaurus": "pnpm --filter livro-caixa-docs",
    "dev:docs": "pnpm docusaurus start",
    "mobile": "pnpm --filter livro-caixa-mobile",
    "android": "bash scripts/android.sh",
    "apk": "bash scripts/apk.sh",
    "typecheck:mobile": "pnpm mobile typecheck",
    "test:mobile": "pnpm mobile test",
    "add-admin": "node scripts/add-admin.mjs",
    "firebase:emulators": "firebase emulators:start",
    "journeys:stack": "bash journeys/stack.sh",
    "journeys:test": "node journeys/test.ts",
    "journeys:inspect": "node journeys/inspect.ts",
    "typecheck:journeys": "tsc -p journeys",
    "test:rules": "firebase -c firebase/firebase.test.json emulators:exec --only firestore --project demo-livro-caixa \"node --test --test-concurrency=1 firebase/rules-tests/*.test.mjs\"",
    "test:contract": "firebase -c firebase/firebase.test.json emulators:exec --only auth,firestore --project demo-livro-caixa \"pnpm mobile test:contract\"",
    "build": "pnpm --recursive build",
    "verify": "pnpm docusaurus test && pnpm docusaurus build",
    "local:trash": "dest=docs/local/__trash/$(date +%Y-%m-%d-%H%M%S) && mkdir -p \"$dest\" && find docs/local -mindepth 1 -maxdepth 1 ! -name __trash -exec mv -t \"$dest\" {} +"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^22.20.5",
    "firebase": "^13.1.0",
    "firebase-tools": "^15.34.1",
    "typescript": "~6.0.3"
  }
}
