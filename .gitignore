# Local Netlify folder
.netlify

# macOS
.DS_Store

# Dependências do workspace pnpm (cada app também ignora a própria)
node_modules

# Pasta de trabalho local: planos do Claude Code, notas, descrições de PR. Nunca vai
# para o repositório.
docs/local/

# Posições das tabelas que o editor do dbdiagram grava ao lado de cada .dbml: é estado do editor,
# não documentação.
*.dbdiagram

# Capturas e artefatos das rodadas das jornadas: cada rodada gera uma pasta nova.
journeys/.local/

# Logs que os emuladores do Firebase gravam na pasta de onde sobem.
*-debug.log
