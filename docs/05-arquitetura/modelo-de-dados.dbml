// Esboço do modelo de dados, pensado para o Firestore. Cada tabela é uma coleção (ou, em tags, os
// itens de um documento só), e a chave primária é o id do documento.
//
// Leituras do Início de um mês: a lista de allowedEmails inteira (dela sai o nome atual de quem
// registrou cada lançamento), o documento único das tags, todas as contas recorrentes e os
// lançamentos do mês (uma consulta por month). O que
// falta pagar e as somas por tag e por membro são calculados no app, com o que já foi lido: não há
// totais gravados. Trocar de mês lê só os lançamentos do novo mês.
//
// Sem servidor próprio: as regras de segurança do Firestore garantem o acesso, a autoria, o
// pagamento único por mês e a trava de remoção do e-mail.
//
// Os arquivos ficam no próprio Firestore, sem o Cloud Storage: cada um tem o registro em files/{id} e
// os bytes em fileContents/{id}, com o mesmo id. O lançamento aponta para o registro do comprovante, e
// os detalhes leem o registro em tempo real sem baixar os bytes, que só o visualizador lê. O lançamento,
// o registro e os bytes entram e saem num lote só. As regras conferem que quem salva está em
// allowedEmails, que é o autor do registro, que o arquivo é imagem ou PDF de até 900 KB e que os bytes têm o
// tamanho que o registro diz.
//
// Valores em dinheiro em centavos, inteiros. Datas sem hora como texto AAAA-MM-DD, e meses como
// AAAA-MM, para o fuso do celular não trocar o dia.

Enum EntryKind {
  recurringPayment [note: 'Pagamento de uma conta recorrente num mês']
  oneOffBill [note: 'Conta avulsa']
  contribution [note: 'Contribuição: parte do valor de um pagamento ou de uma conta avulsa, posta por outro membro']
}

Enum FileType {
  image [note: 'Imagem de até 900 KB; acima disso, comprimida no app e salva em WebP']
  pdf [note: 'PDF de até 900 KB, com qualquer número de páginas, guardado como está; o maior é recusado']
}

Table allowedEmails {
  email varchar [pk, note: 'Id do documento: o e-mail em minúsculas. As regras conferem o acesso com exists() neste caminho, a partir do e-mail do login']
  uid varchar [unique, note: 'O uid do login da pessoa. Vazio até a primeira entrada, quando o app o grava junto com o nome. Depois o app nunca o troca (as regras recusam); trocar a conta Google de uma pessoa é um script do Admin SDK. Os lançamentos apontam para ele']
  name varchar [note: 'O nome que o app mostra. Vazio até a primeira entrada da pessoa, quando o app grava o nome da conta Google (sem nome na conta, o começo do e-mail). Depois, só a própria pessoa o altera. O nome não fica vazio e tem até 60 caracteres, e a primeira entrada corta o da conta Google nesse limite']
  isAdmin boolean [not null, default: false, note: 'Marcado à mão no console do Firebase. As regras não deixam o app gravar true. O esperado é um admin só, sem verificação']
  hasEntries boolean [not null, default: false, note: 'Vira true no mesmo lote do primeiro lançamento da pessoa, e as regras do lançamento exigem isso (getAfter). Com true, as regras recusam excluir o e-mail']

  Note: 'A lista de e-mails permitidos. Só o admin cria, só com o e-mail, e exclui; cada pessoa grava e altera só o próprio nome (e grava o uid uma vez). Todo membro lê a lista inteira, para mostrar o nome atual de quem registrou cada lançamento.'
}

Table tags {
  id varchar [pk, note: 'A chave do item no mapa items do documento settings/tags']
  name varchar [not null]
  nameKey varchar [not null, unique, note: 'O nome em minúsculas e sem acento. Criar e renomear acontecem numa transação sobre o documento único, que confere que a chave não existe']
  color varchar [not null, note: 'Um valor do enum de cores definido no código; a lista de cores sai do design']

  Note: 'Todas as tags num documento só, settings/tags: uma leitura traz todas, e a transação garante o nome único. A exclusão confere antes, no app, que nenhuma conta usa a tag.'
}

Table recurringBills {
  id varchar [pk]
  name varchar [not null]
  expectedAmountCents int [not null, note: 'O valor previsto; quem paga confirma ou corrige']
  dayOfMonth int [not null, note: 'De 1 a 31; num mês mais curto, a conta vence no último dia']
  startsOn varchar [not null, note: 'AAAA-MM-DD. Um mês só tem a conta se o vencimento dele cai nesta data ou depois']
  tagId varchar [ref: > tags.id, note: 'Opcional']

  Note: 'Coleção pequena, lida inteira. Os meses não são gravados: cada mês a pagar sai deste cadastro. A exclusão apaga o documento, porque os pagamentos guardam a própria cópia do nome e da tag.'
}

Table entries {
  id varchar [pk, note: 'No pagamento, month + "_" + recurringBillId: o segundo pagamento do mês encontra o documento existente, e as regras recusam a escrita para qualquer pessoa, o autor inclusive. Na conta avulsa e na contribuição, um id gerado, que as regras não deixam ter a forma do pagamento (AAAA-MM_...), para elas não ocuparem o id de uma conta recorrente']
  kind EntryKind [not null]
  month varchar [not null, note: 'AAAA-MM. Os lançamentos do Início vêm de uma consulta por este campo']
  entryId varchar [ref: > entries.id, note: 'Só na contribuição: o lançamento que ela recebe, o pagamento do mês (com dono ou sem) ou a conta avulsa. As regras exigem que ele exista ao fim do lote, com o mesmo month. A contribuição não tem name, date, tagId, dueDay nem expectedAmountCents: vêm desse lançamento']
  recurringBillId varchar [ref: > recurringBills.id, note: 'Só no pagamento. As regras exigem que a conta exista na hora do pagamento; depois pode ficar apontando para uma conta já excluída']
  name varchar [note: 'Na conta avulsa e no pagamento; no pagamento, cópia do nome da conta no momento do pagamento ou da primeira contribuição']
  amountCents int [note: 'No pagamento, começa com o valor previsto e pode ser corrigido. Vazio no pagamento sem dono, cujo total é a soma das contribuições, calculada pelo app']
  dueDay int [note: 'Só no pagamento: o dia (1 a 31) em que a conta vencia naquele mês, cópia no momento do pagamento (o dia 31 vira 30 num mês de 30 dias)']
  expectedAmountCents int [note: 'Só no pagamento: cópia do valor previsto da conta no momento do pagamento ou da primeira contribuição, para o mês não mudar quando a conta mudar. O pagamento sem dono está pago quando a soma das contribuições alcança este valor']
  date varchar [note: 'Só na conta avulsa: AAAA-MM-DD, preenchida com hoje. Trocar a data para outro mês muda o month junto']
  tagId varchar [ref: > tags.id, note: 'Opcional. No pagamento, cópia da tag da conta no momento do pagamento']
  paidBy varchar [ref: > allowedEmails.uid, note: 'O uid do login de quem registrou. Vazio só no pagamento sem dono, gravado na primeira contribuição de um mês sem pagamento; pagar esse mês é preencher o paidBy, o amountCents e o receiptFileId, por qualquer membro. As regras exigem o uid de quem grava (request.auth.uid) e só deixam o autor alterar ou excluir. O nome não é copiado: o app o acha na lista pelo uid, e uma troca de nome chega aos lançamentos antigos']
  createdAt timestamp [not null, note: 'Quando o lançamento foi registrado, gravado pelo servidor (serverTimestamp). Aparece nos detalhes do lançamento']
  receiptFileId varchar [ref: - files.id, note: 'O comprovante, vazio só no pagamento sem dono. As regras exigem que o registro exista ao fim do lote (getAfter) e tenha sido enviado por quem grava o lançamento']

  indexes {
    (month, recurringBillId) [unique, note: 'Garantido pelo id do documento, não por um índice: o Firestore não tem índice único']
    month
    tagId
  }

  Note: 'Os lançamentos, pagamentos, contas avulsas e contribuições, numa coleção só: uma consulta traz o mês inteiro, e o app calcula com ela o que falta e a parte de cada membro, sem totais gravados. O pagamento sem dono nasce no lote da primeira contribuição de um mês sem pagamento, e qualquer membro o cria e apaga; a contribuição que vira pagamento, ou o contrário, é um lote só, com o mesmo comprovante. Só o autor altera: no pagamento, o valor pago e o comprovante; na conta avulsa, o nome, o valor, a data (e o month com ela), a tag e o comprovante. Trocar o comprovante é um lote: cria o files e o fileContents novos, atualiza o lançamento e apaga os antigos. Excluir é um lote que apaga o lançamento, o files e o fileContents dele. Excluir não desfaz o hasEntries.'
}

Table files {
  id varchar [pk, note: 'Id gerado pelo app antes do lote']
  name varchar [not null, note: 'O nome do arquivo escolhido (1 a 255 caracteres), que o app mostra nos detalhes e no visualizador']
  type FileType [not null]
  contentType varchar [not null, note: 'image/... para a imagem (image/webp quando comprimida) e application/pdf para o PDF; as regras conferem o par com o type']
  sizeBytes int [not null, note: 'Até 900 KB (921.600 bytes), o tamanho de fileContents.content, conferido pelas regras']
  uploadedBy varchar [not null, note: 'O uid do login de quem salvou. Só ele exclui o registro e os bytes']

  Note: 'Todos os arquivos do app, num lugar só. Hoje só há comprovantes, cada um usado por um lançamento. Todo membro lê um registro por id (nunca a lista). Não há update: trocar o comprovante cria um registro novo e apaga o antigo no mesmo lote.'
}

Table fileContents {
  id varchar [pk, ref: - files.id, note: 'O mesmo id do registro em files']
  content bytes [not null, note: 'Os bytes da imagem ou do PDF, até 900 KB: um documento do Firestore tem no máximo 1 MiB']

  Note: 'Os bytes de cada arquivo, separados do registro para os detalhes, que leem files em tempo real, não baixarem o arquivo. Todo membro lê um por id (nunca a lista). Só quem salvou o registro cria, no mesmo lote dele, e exclui, no lote que apaga o registro. Não há update.'
}
