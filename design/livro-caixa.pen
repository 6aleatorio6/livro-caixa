                {
                  "type": "text",
                  "id": "m2zOk",
                  "name": "Regras",
                  "fill": "#1C1C1A",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Plana, sem contorno, de formas arredondadas e pouco detalhe: objetos da casa parados, em luz de janela. Só as cores da paleta e das referências (sálvia, menta, água, branco quente), com a madeira clara em pouca área. Nunca rosto, mascote ou cena com pessoas; nada infantil. Aparece em estados vazios e de mês fechado, nunca na lista do dia a dia.",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
            },
